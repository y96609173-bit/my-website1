# Vercel Environment Variables Configuration for Project Inquiry Form
# Rename this file to .env (local development only, do not commit to Git)
# Or configure these keys inside Vercel Dashboard -> Settings -> Environment Variables

# --- SPAM PROTECTION ---
# Honeypot name check: matches the hidden field (handled automatically by api/submit.js)

# --- NOTIFICATION METHOD A: DISCORD WEBHOOK (Recommended, Instant & Free) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token

# --- NOTIFICATION METHOD B: TELEGRAM BOT ---
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=987654321

# --- NOTIFICATION METHOD C: SMTP / EMAIL (Nodemailer) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# TO_EMAIL=owner-recipient-email@domain.com
